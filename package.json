{
  "name": "scat-preprocessor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "研究データを外部送信せず、逐語録をSCAT形式へ整えるオフラインWebツール",
  "scripts": {
    "build": "node scripts/build-offline.mjs",
    "dev": "npm run build && vite dist --host 0.0.0.0",
